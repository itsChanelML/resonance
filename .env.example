# Copy this file to .env and fill in your real keys.
# .env itself is gitignored, this template is not.

# Required. Get a free key at build.nvidia.com (no credit card).
NVIDIA_API_KEY=nvapi-your-key-here

# Required. Get a free key at elevenlabs.io > Settings > API Keys.
ELEVENLABS_API_KEY=sk_your-key-here

# Optional. Defaults to "Rachel" if unset. Browse voices at elevenlabs.io.
ELEVENLABS_VOICE_ID=put-your-voice-id-here

# Optional. Speech speed, 0.7 (slower) to 1.2 (faster). Defaults to 1.0.
ELEVENLABS_SPEED=1.0

# Optional. Voice stability, 0 (expressive) to 1 (even). Defaults to 0.5.
ELEVENLABS_STABILITY=0.5

# Optional. Set to "false" for a fully silent, text-only mode (resonance.py only).
VOICE_OUTPUT=true

# Optional. Hold this key to talk. A pynput Key name (f9, ctrl_r, ctrl_l, alt,
# shift_r, ...) or a single character. Defaults to right-Control.
RESONANCE_HOTKEY=ctrl_r

# Optional. Soft caps used to warn as you approach each vendor's free-tier
# limits (see "The free-tier math" in the README). Tracked locally in
# .usage.json, resets automatically each calendar month.
NIM_REQUEST_WARNING=1000
ELEVENLABS_CHARACTER_WARNING=10000

# Optional, project mode only. Extra guidance for "what evidence..." and
# "which one experiment..." questions. On by default; "false" turns it off.
RESONANCE_TURN_HINTS=true

# Optional, experimental, off by default. Rewrite the final answer with
# thinking on, or with another NIM model. Slower; see docs/BASELINE.md.
RESONANCE_FINAL_THINKING=false
# RESONANCE_FINAL_MODEL=nvidia/nemotron-3-super-120b-a12b

# Optional, project mode only. Before showing an answer, check it once for a
# next step that is just "read more code" and for numbers that appear in nothing
# it inspected; if found, the model gets one chance to fix it. "false" turns it off.
RESONANCE_REVISE=true
